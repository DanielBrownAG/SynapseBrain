AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your_api_key_here"
AZURE_OPENAI_DEPLOYMENT_ID="your_deployment_name_here"
# Azure v1 API; use your actual deployment name, including custom GPT-6+ names.
AZURE_OPENAI_API_MODE=responses
AZURE_OPENAI_MAX_OUTPUT_TOKENS=8192
# Optional; choose an effort supported by your deployed model.
# AZURE_OPENAI_REASONING_EFFORT=low
# Stored chat history and extracted memory (keep this directory private).
SYNAPSE_DATA_DIR=data/sessions
SYNAPSE_ROUTING_MODE=adaptive
SYNAPSE_REQUEST_MAX_TOKENS=65536
SYNAPSE_REQUEST_TIMEOUT_MS=120000
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
